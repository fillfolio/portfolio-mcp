    {
      "name": "list_budgets",
      "title": "Monthly budgets",
      "description": "Read stored monthly category limits and full-month actuals in each original currency. Limits repeat without rollover. Requires explicit budget-read permission. No bank refresh or edits.",
      "scope": "budgets:read",
      "readOnly": true,
      "availability": "Active ULTRA/HYPER accounts with explicit bank consent and per-client permission",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          }
        },
        "required": [
          "month"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string"
          },
          "partial": {
            "type": "boolean"
          },
          "missing": {
            "type": "array",
            "items": {
